DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rpcn?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# Google Calendar (Module 3 Feature 1). Optional - the app runs without these,
# but the "Connect Google Calendar" flow needs them. Create an OAuth 2.0
# "Web application" client at https://console.cloud.google.com, enable the
# Google Calendar API, and add GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/callback"

# Google Gemini (Module 3 Feature 3 - Proposal Quality Assistant). Optional.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# OpenAlex (Module 3 Feature 5 - Academic Publication Search). No API key
# exists; this optional contact email just enables their faster "polite pool".
OPENALEX_MAILTO=""
